+            message.push_back(',');
+          }
+          const auto& op = runtime.streamOps[i];
+          message.push_back('[');
+          AppendJsonNumber(message, op[0]);
+          message.push_back(',');
+          AppendJsonNumber(message, op[1]);
+          message.push_back(',');
+          AppendJsonNumber(message, op[2]);
+          message.push_back(']');
+        }
+        message.push_back(']');
+        runtime.streamOps.clear();
+      }
+    }
