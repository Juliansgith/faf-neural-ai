diff --git a/src/sdk/moho/ai/CAiSteeringImpl.cpp b/src/sdk/moho/ai/CAiSteeringImpl.cpp
index 3e96b86c..62255e2f 100644
--- a/src/sdk/moho/ai/CAiSteeringImpl.cpp
+++ b/src/sdk/moho/ai/CAiSteeringImpl.cpp
@@ -813,15 +813,28 @@ namespace
     // 0x005D38CA..0x005D3921: sphere {owner position, query radius}, unit mask
     // 0x100, through COGrid::ForAllEntitiesIterator (0x00721FB0). The binary's
     // hit buffer is a fastvector_n of 20; the recovered signature takes 10.
+    //
+    // Engine change: the binary collects every unit the sphere query accepts
+    // and then filters them; the query's own acceptance test (an inner-box
+    // overlap or a precise sphere-primitive test, COGrid::SphereQueryAccepts)
+    // now runs after the cheap filters that do not depend on it. Every test is
+    // a pure read, and the lists come out in the same grid order with the
+    // same units: only the precise tests of units that were dropped anyway
+    // are skipped.
     const float queryRadius = ComputeCollisionQueryRadius(*owner, steering.mPath);
     const Wm3::Sphere3f querySphere{owner->GetPosition(), queryRadius};
-    gpg::core::FastVectorN<CollisionResult, 10> collisions{};
-    owner->SimulationRef->mOGrid->ForAllEntitiesIterator(collisions, ENTITYTYPE_Unit, querySphere);
+    COGrid& grid = *owner->SimulationRef->mOGrid;
+    const COGrid::SphereQuery query(querySphere);
+    gpg::core::FastVectorN<Entity*, 20> gathered{};
+    const int gatheredCount = grid.GatherUnmarkedEntities(query.Bounds(), ENTITYTYPE_Unit, gathered);
 
     // 0x005D395D..0x005D3A29: every hit, in grid order, through the binary's filters.
-    for (const CollisionResult& hit : collisions) {
-      Entity* const entity = hit.sourceEntity;
-      Unit* const candidate = entity ? entity->IsUnit() : nullptr;
+    for (int index = 0; index < gatheredCount; ++index) {
+      Entity* const entity = gathered.start_[index];
+      if (entity == nullptr) {
+        continue;
+      }
+      Unit* const candidate = entity->IsUnit();
       if (!candidate) {
         continue;
       }
@@ -841,6 +854,11 @@ namespace
         continue;
       }
 
+      // ForAllEntitiesIterator's acceptance test for this entity.
+      if (!query.Accepts(*entity)) {
+        continue;
+      }
+
       // 0x005D39AB..0x005D39D0: same army (Unit+0x154, Entity::ArmyRef) and the
       // candidate does not outrank the owner, so the candidate yields. The call
       // at 0x005D39C3 is candidate->IsHigherPriorityThan(owner): this in ecx,
diff --git a/src/sdk/moho/sim/COGrid.cpp b/src/sdk/moho/sim/COGrid.cpp
index 5f3879e9..efb8744f 100644
--- a/src/sdk/moho/sim/COGrid.cpp
+++ b/src/sdk/moho/sim/COGrid.cpp
@@ -1422,6 +1422,43 @@ namespace moho
     return SweptPathBlockedByUnit(grid, unit, fromCenter, toCenter, mode);
   }
 
+  /**
+   * Engine addition: ForAllEntitiesIterator's per-entity acceptance test, so a
+   * caller that filters the gathered entities can run it after its own cheap
+   * filters (see COGrid::SphereQuery in COGrid.h).
+   */
+  COGrid::SphereQuery::SphereQuery(const Wm3::Sphere3f& sphere) noexcept
+    : mSphere(sphere)
+    , mBounds(BuildAxisAlignedBoundsFromSphere(sphere))
+    , mSmall(sphere.Radius <= 3.0f)
+  {
+    constexpr float kInnerBoundsScale = 0.70700002f;
+    const float innerRadius = sphere.Radius * kInnerBoundsScale;
+    mInnerBounds.Min.x = sphere.Center.x - innerRadius;
+    mInnerBounds.Min.y = sphere.Center.y - innerRadius;
+    mInnerBounds.Min.z = sphere.Center.z - innerRadius;
+    mInnerBounds.Max.x = sphere.Center.x + innerRadius;
+    mInnerBounds.Max.y = sphere.Center.y + innerRadius;
+    mInnerBounds.Max.z = sphere.Center.z + innerRadius;
+  }
+
+  bool COGrid::SphereQuery::Accepts(const Entity& candidate, CollisionResult* const outResult) const
+  {
+    // 0x00722171..0x0072218F: per axis `comiss innerMin, entity.Max; ja reject` and
+    // `comiss entity.Min, innerMax; ja reject` -- an AABB *overlap* test, so any entity touching
+    // the inner box is accepted without the sphere test. (This site used to test containment,
+    // which sent such entities on to `CollideSphere` and could drop hits the binary keeps.)
+    // Radii of at most 3 skip the inner box and always run the sphere test.
+    if (!mSmall && AxisAlignedBoundsOverlapEntityBounds(mInnerBounds, candidate)) {
+      return true;
+    }
+
+    CColPrimitiveBase* const collisionPrimitive = candidate.CollisionExtents;
+    CollisionResult scratch{};
+    return collisionPrimitive != nullptr &&
+      collisionPrimitive->CollideSphere(&mSphere, outResult != nullptr ? outResult : &scratch);
+  }
+
   /**
    * Address: 0x00721FB0 (FUN_00721FB0, Moho::COGrid::ForAllEntitiesIterator)
    *
@@ -1436,60 +1473,20 @@ namespace moho
     const Wm3::Sphere3f& sphere
   )
   {
-    const Wm3::AxisAlignedBox3f queryBounds = BuildAxisAlignedBoundsFromSphere(sphere);
+    const SphereQuery query(sphere);
 
     gpg::core::FastVectorN<Entity*, 20> gatheredEntities{};
-    const int gatheredCount = GatherUnmarkedEntities(queryBounds, flags, gatheredEntities);
+    const int gatheredCount = GatherUnmarkedEntities(query.Bounds(), flags, gatheredEntities);
 
     outCollisions.ResetStorageToInline();
 
+    // One result block for the whole walk, as the binary keeps it: an entity
+    // accepted by the inner-box test is pushed with whatever the last sphere
+    // test left in the other fields.
     CollisionResult collisionResult{};
-    if (sphere.Radius <= 3.0f) {
-      for (int index = 0; index < gatheredCount; ++index) {
-        Entity* const candidate = gatheredEntities.start_[index];
-        if (candidate == nullptr) {
-          continue;
-        }
-
-        CColPrimitiveBase* const collisionPrimitive = candidate->CollisionExtents;
-        if (collisionPrimitive == nullptr || !collisionPrimitive->CollideSphere(&sphere, &collisionResult)) {
-          continue;
-        }
-
-        collisionResult.sourceEntity = candidate;
-        outCollisions.PushBack(collisionResult);
-      }
-      return;
-    }
-
-    constexpr float kInnerBoundsScale = 0.70700002f;
-    const float innerRadius = sphere.Radius * kInnerBoundsScale;
-    Wm3::AxisAlignedBox3f innerBounds{};
-    innerBounds.Min.x = sphere.Center.x - innerRadius;
-    innerBounds.Min.y = sphere.Center.y - innerRadius;
-    innerBounds.Min.z = sphere.Center.z - innerRadius;
-    innerBounds.Max.x = sphere.Center.x + innerRadius;
-    innerBounds.Max.y = sphere.Center.y + innerRadius;
-    innerBounds.Max.z = sphere.Center.z + innerRadius;
-
     for (int index = 0; index < gatheredCount; ++index) {
       Entity* const candidate = gatheredEntities.start_[index];
-      if (candidate == nullptr) {
-        continue;
-      }
-
-      // 0x00722171..0x0072218F: per axis `comiss innerMin, entity.Max; ja reject` and
-      // `comiss entity.Min, innerMax; ja reject` -- an AABB *overlap* test, so any entity touching
-      // the inner box is accepted without the sphere test. (This site used to test containment,
-      // which sent such entities on to `CollideSphere` and could drop hits the binary keeps.)
-      if (AxisAlignedBoundsOverlapEntityBounds(innerBounds, *candidate)) {
-        collisionResult.sourceEntity = candidate;
-        outCollisions.PushBack(collisionResult);
-        continue;
-      }
-
-      CColPrimitiveBase* const collisionPrimitive = candidate->CollisionExtents;
-      if (collisionPrimitive == nullptr || !collisionPrimitive->CollideSphere(&sphere, &collisionResult)) {
+      if (candidate == nullptr || !query.Accepts(*candidate, &collisionResult)) {
         continue;
       }
 
diff --git a/src/sdk/moho/sim/COGrid.h b/src/sdk/moho/sim/COGrid.h
index 64dff0e6..e10b41c0 100644
--- a/src/sdk/moho/sim/COGrid.h
+++ b/src/sdk/moho/sim/COGrid.h
@@ -334,6 +334,35 @@ namespace moho
       const Wm3::Sphere3f& sphere
     );
 
+    /**
+     * Engine addition: the query ForAllEntitiesIterator runs for one sphere -
+     * the gather bounds, and the per-entity acceptance test (an overlap with
+     * the inner 0.707r box for radii above 3, otherwise or failing that the
+     * entity's own CollideSphere). A caller that filters the gathered
+     * entities anyway can gather `Bounds()` itself and test `Accepts` after
+     * its cheaper filters; every step is a pure read, so the accepted set and
+     * its order are the same.
+     */
+    class SphereQuery
+    {
+    public:
+      explicit SphereQuery(const Wm3::Sphere3f& sphere) noexcept;
+
+      [[nodiscard]] const Wm3::AxisAlignedBox3f& Bounds() const noexcept { return mBounds; }
+
+      /**
+       * Whether ForAllEntitiesIterator would report `candidate`. A sphere
+       * test writes its contact into `outResult` when one is given.
+       */
+      [[nodiscard]] bool Accepts(const Entity& candidate, CollisionResult* outResult = nullptr) const;
+
+    private:
+      Wm3::Sphere3f mSphere;
+      Wm3::AxisAlignedBox3f mBounds;
+      Wm3::AxisAlignedBox3f mInnerBounds{};
+      bool mSmall;
+    };
+
