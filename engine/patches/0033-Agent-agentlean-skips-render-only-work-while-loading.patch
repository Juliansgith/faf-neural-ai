From f89d2b15e543854d1519e39f6b02cdbc0b93eb7f Mon Sep 17 00:00:00 2001
From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Wed, 30 Sep 2026 21:10:56 +0200
Subject: [PATCH 33/52] Agent: /agentlean skips render-only work while loading
 blueprints

A training game is never drawn, but its blueprint loading (RRuleGameRules
on the scenario loader thread) did two things only the renderer needs:

- four strategic-icon textures per unit blueprint, created through the D3D
  device -- the loader thread waited on the device lock (the main thread
  renders the loading screen meanwhile): 40-70 % of the loader's samples
  in ZwWaitForAlertByThreadId under LoadStrategicIconTexture;
- a file search per LOD for each of the four material textures a mesh
  blueprint leaves implicit (albedo, normals, specular, lookup), through
  the VFS and the file system.

With /agentlean (and the bridge on) both are skipped; the mesh file itself
is still resolved, since the sim reads its skeleton. The renderer already
handles a missing icon or texture. Measured on this machine (3 load-only
launches each, same build): blueprint loading 5.3 s -> 2.8 s, launch to
first observation 10.8 s -> 8.4 s; a full 36-minute game played normally
with no new warnings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ff36b46d65ecedd3b293650f9122cbfc40cbb4a6)
(cherry picked from commit f29fdf51915b0fa9ebe5a6d62527f2cb72a7d74b)
---
 src/sdk/moho/agent/AgentBridge.cpp            |  8 +++++++
 src/sdk/moho/agent/AgentBridge.h              | 12 +++++++++++
 src/sdk/moho/entity/REntityBlueprint.cpp      |  6 ++++++
 .../resource/blueprints/RMeshBlueprint.cpp    | 21 +++++++++++++------
 4 files changed, 41 insertions(+), 6 deletions(-)

diff --git a/src/sdk/moho/agent/AgentBridge.cpp b/src/sdk/moho/agent/AgentBridge.cpp
index 52b730bf..7c37ea07 100644
--- a/src/sdk/moho/agent/AgentBridge.cpp
+++ b/src/sdk/moho/agent/AgentBridge.cpp
@@ -60,6 +60,7 @@ namespace moho
       int speed = kDefaultAgentSpeed;
       int connectTimeoutSeconds = kDefaultConnectTimeoutSeconds;
       bool keepVisualEffects = false;
+      bool leanLoading = false;
       int watchdogSeconds = 60;
     };
 
@@ -102,6 +103,7 @@ namespace moho
         config.connectTimeoutSeconds = std::max(1, ParseIntArgument(args[0], kDefaultConnectTimeoutSeconds));
       }
       config.keepVisualEffects = CFG_GetArgOption("/agentvfx", 0, nullptr);
+      config.leanLoading = CFG_GetArgOption("/agentlean", 0, nullptr);
       if (CFG_GetArgOption("/agentwatchdog", 1, &args) && !args.empty()) {
         config.watchdogSeconds = std::max(0, ParseIntArgument(args[0], config.watchdogSeconds));
       }
@@ -1367,4 +1369,10 @@ namespace moho
   {
     return AGENT_UserDrainsAllBeats() && !Config().keepVisualEffects;
   }
+
+  bool AGENT_SkipRenderOnlyAssets()
+  {
+    const AgentBridgeConfig& config = Config();
+    return config.enabled && config.leanLoading;
+  }
 } // namespace moho
diff --git a/src/sdk/moho/agent/AgentBridge.h b/src/sdk/moho/agent/AgentBridge.h
index 8833c4ee..95ae78a0 100644
--- a/src/sdk/moho/agent/AgentBridge.h
+++ b/src/sdk/moho/agent/AgentBridge.h
@@ -19,6 +19,9 @@ namespace moho
    *                          10 is the fastest normal game speed and 0 is real time
    *   /agenttimeout <secs>   how long to keep retrying the initial connection (default 60)
    *   /agentvfx              keep particle effects while unpaced (skipped by default then)
+   *   /agentlean             skip loading work that only feeds the renderer (strategic-icon textures,
+   *                          searches for implicit mesh material textures); for training games that are
+   *                          never drawn
    *   /agentwatchdog <secs>  if the sim thread makes no progress for this long, log the Lua
    *                          traceback, send it to the agent and exit (default 60, 0 disables)
    *
@@ -84,4 +87,13 @@ namespace moho
    * is separate from the sim's, so skipping them cannot change the game.
    */
   [[nodiscard]] bool AGENT_SkipParticleEmission();
+
+  /**
+   * True with /agentlean (and the bridge on): blueprint loading skips work that only the renderer uses --
+   * the strategic-icon textures (four per unit blueprint, created on the loader thread through the D3D
+   * device the main thread renders the loading screen with: it waits on that device's lock) and the file
+   * searches for mesh material textures a blueprint does not name. The sim reads neither, and the renderer
+   * already copes with an icon or texture that is missing.
+   */
+  [[nodiscard]] bool AGENT_SkipRenderOnlyAssets();
 } // namespace moho
diff --git a/src/sdk/moho/entity/REntityBlueprint.cpp b/src/sdk/moho/entity/REntityBlueprint.cpp
index d4bf915c..3ed5b399 100644
--- a/src/sdk/moho/entity/REntityBlueprint.cpp
+++ b/src/sdk/moho/entity/REntityBlueprint.cpp
@@ -1,4 +1,5 @@
 #include "moho/entity/REntityBlueprint.h"
+#include "moho/agent/AgentBridge.h"
 
 #include <cmath>
 
@@ -196,6 +197,11 @@ namespace moho
       return;
     }
 
+    // Engine addition: a training game that is never drawn skips the icon textures (/agentlean).
+    if (AGENT_SkipRenderOnlyAssets()) {
+      return;
+    }
+
     const msvc8::string iconBasePath = msvc8::string(kStrategicIconDirectory) + mStrategicIconName;
 
     mStrategicIconRest = LoadStrategicIconTexture(iconBasePath + "_rest.dds", msvc8::string("'rest'"));
diff --git a/src/sdk/moho/resource/blueprints/RMeshBlueprint.cpp b/src/sdk/moho/resource/blueprints/RMeshBlueprint.cpp
index 24e01f7e..2bd4c7cf 100644
--- a/src/sdk/moho/resource/blueprints/RMeshBlueprint.cpp
+++ b/src/sdk/moho/resource/blueprints/RMeshBlueprint.cpp
@@ -1,4 +1,5 @@
 #include "RMeshBlueprint.h"
+#include "moho/agent/AgentBridge.h"
 
 #include <algorithm>
 #include <cstring>
@@ -68,7 +69,10 @@ namespace moho
     }
 
     void ResolveExplicitOrFallbackPath(
-      msvc8::string& destination, const std::string_view sourcePath, const std::string_view fallbackName
+      msvc8::string& destination,
+      const std::string_view sourcePath,
+      const std::string_view fallbackName,
+      const bool probeFallback = true
     )
     {
       if (!destination.empty()) {
@@ -79,7 +83,7 @@ namespace moho
         return;
       }
 
-      if (ResourceFileExists(fallbackName)) {
+      if (probeFallback && ResourceFileExists(fallbackName)) {
         destination.assign_owned(fallbackName);
       }
     }
@@ -267,13 +271,18 @@ namespace moho
       }
     }
 
-    ResolveExplicitOrFallbackPath(mAlbedoName, sourcePath.view(), sourcePrefix + "_albedo.dds");
+    // Engine addition: a training game that is never drawn does not search for the material textures a
+    // blueprint leaves implicit (/agentlean; four file lookups per LOD, render-only). The mesh itself is
+    // still resolved: the sim reads its skeleton.
+    const bool probeTextures = !AGENT_SkipRenderOnlyAssets();
 
-    ResolveExplicitOrFallbackPath(mNormalsName, sourcePath.view(), sourcePrefix + "_normalsTS.dds");
+    ResolveExplicitOrFallbackPath(mAlbedoName, sourcePath.view(), sourcePrefix + "_albedo.dds", probeTextures);
 
-    ResolveExplicitOrFallbackPath(mSpecularName, sourcePath.view(), sourcePrefix + "_SpecTeam.dds");
+    ResolveExplicitOrFallbackPath(mNormalsName, sourcePath.view(), sourcePrefix + "_normalsTS.dds", probeTextures);
 
-    ResolveExplicitOrFallbackPath(mLookupName, sourcePath.view(), sourcePrefix + "_lookup.dds");
+    ResolveExplicitOrFallbackPath(mSpecularName, sourcePath.view(), sourcePrefix + "_SpecTeam.dds", probeTextures);
+
+    ResolveExplicitOrFallbackPath(mLookupName, sourcePath.view(), sourcePrefix + "_lookup.dds", probeTextures);
   }
 
   /**
