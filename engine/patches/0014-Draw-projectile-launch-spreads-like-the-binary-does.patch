+  Wm3::Vector3f RProjectileBlueprint::GetRandomLaunchOffset(CRandomStream* const randomStream) const
+  {
+    Wm3::Vector3f offset{};
+    offset.x = SampleSymmetricRange(randomStream, Physics.PositionXRange) + Physics.PositionX;
