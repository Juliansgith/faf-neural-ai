 src/sdk/lua/LuaObject.h | 294 ++++++++++++++++++++++++++++------------
 1 file changed, 209 insertions(+), 85 deletions(-)

diff --git a/src/sdk/lua/LuaObject.h b/src/sdk/lua/LuaObject.h
index 62449e06..e9407449 100644
