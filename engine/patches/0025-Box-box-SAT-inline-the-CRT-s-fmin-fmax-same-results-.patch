From cbae35a05003d0d99dce571a7624fcc337a92a7a Mon Sep 17 00:00:00 2001
From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Wed, 30 Sep 2026 21:22:46 +0200
Subject: [PATCH 25/56] Box-box SAT: inline the CRT's fmin/fmax (same results,
 no calls)

ComputeBoxBoxContactManifold (CColPrimitive_Box::CollideBox, 0x00474830)
is the sim thread's top hotspot in battles: every AABB-overlapping pair in
COGrid::CollectEntitiesInBox, recon and weapon probes runs the full
15-axis SAT. Its two std::fmin/std::fmax per axis compiled to calls into
ucrtbase (fminf/fmaxf are not intrinsics), and those calls alone were
3.6-7.8 % of the sim thread's samples in a 36-minute skirmish (teacher vs
the adaptive AI; sampled at minutes 15, 25 and 33).

CrtFminf/CrtFmaxf reproduce the CRT's results exactly: a NaN argument
yields the other one (two NaNs: the second, quieted), and between +0 and
-0 min returns -0 and max +0. Checked against ucrtbase's fminf/fmaxf on
20 million random bit patterns plus signed zeros, infinities and
quiet/signalling NaNs (no mismatch), and a structural copy of the SAT
with either version agreed bit for bit on 262144 random box pairs while
running 14 % faster per call (19 % of the pairs overlapping; overlapping
pairs gain more). main.exe no longer imports fminf/fmaxf.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 2dc5ede49c3dab80cda9b455740a638832e39249)
---
 src/sdk/moho/collision/CColPrimitiveBase.cpp | 51 +++++++++++++++++++-
 1 file changed, 50 insertions(+), 1 deletion(-)

diff --git a/src/sdk/moho/collision/CColPrimitiveBase.cpp b/src/sdk/moho/collision/CColPrimitiveBase.cpp
index f7340d89..3d24cff0 100644
--- a/src/sdk/moho/collision/CColPrimitiveBase.cpp
+++ b/src/sdk/moho/collision/CColPrimitiveBase.cpp
@@ -1,6 +1,7 @@
 #include "moho/collision/CColPrimitiveBase.h"
 
 #include <array>
+#include <bit>
 #include <cmath>
 #include <cstdint>
 #include <limits>
@@ -98,6 +99,54 @@ namespace
     return support;
   }
 
+  /**
+   * What it does:
+   * `std::fmin`/`std::fmax` for floats with the CRT's exact results, inline. The CRT versions are calls
+   * into ucrtbase that the compiler cannot inline, and the box-box SAT below makes two of them per
+   * candidate axis: in large battles about 7 % of the sim thread was spent inside `fminf`/`fmaxf`
+   * alone. Same results bit for bit, checked against ucrtbase on 20 million random bit patterns plus
+   * signed zeros, infinities and quiet/signalling NaNs: a NaN argument yields the other one (two NaNs:
+   * the second, quieted), and between +0 and -0 min gives -0 and max gives +0.
+   */
+  [[nodiscard]] inline float QuietedNaN(const float value) noexcept
+  {
+    return std::bit_cast<float>(std::bit_cast<std::uint32_t>(value) | 0x00400000u);
+  }
+
+  [[nodiscard]] inline float CrtFminf(const float x, const float y) noexcept
+  {
+    if (x < y) {
+      return x;
+    }
+    if (y < x) {
+      return y;
+    }
+    if (x == y) {
+      return std::signbit(x) ? x : y;
+    }
+    if (y != y) {
+      return (x != x) ? QuietedNaN(y) : x;
+    }
+    return y;
+  }
+
+  [[nodiscard]] inline float CrtFmaxf(const float x, const float y) noexcept
+  {
+    if (x > y) {
+      return x;
+    }
+    if (y > x) {
+      return y;
+    }
+    if (x == y) {
+      return std::signbit(x) ? y : x;
+    }
+    if (y != y) {
+      return (x != x) ? QuietedNaN(y) : x;
+    }
+    return y;
+  }
+
   struct BoxBoxContactManifold
   {
     Wm3::Vec3f pointOnA;          // +0x00
@@ -147,7 +196,7 @@ namespace
       if (lhsMin > rhsMax || rhsMin > lhsMax) {
         return false;
       }
-      overlapAlongAxis[axisIndex] = std::fmin(lhsMax, rhsMax) - std::fmax(lhsMin, rhsMin);
+      overlapAlongAxis[axisIndex] = CrtFminf(lhsMax, rhsMax) - CrtFmaxf(lhsMin, rhsMin);
     }
 
     float bestDepth = std::numeric_limits<float>::max();
