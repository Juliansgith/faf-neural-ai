From 2c30ca8e6f8adcd0c328c473f4c6a0244de4312a Mon Sep 17 00:00:00 2001
From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:12:41 +0200
Subject: [PATCH 11/52] Let TaskTick errors propagate as in the binary

LuaFunction<int>::operator() (0x006241B0) calls the unprotected lua_call
(0x0090D400), so an error in a script task's TaskTick unwinds to
CUnitScriptTask::Execute, which logs it and ends the task. In this tree
`lua_call` maps to the protected call: the error message came back as the
"result", converted to 0 -- TASKSTATUS.Repeat -- and a TaskTick that errored
every time (EnhanceTask, see "Register SecondsPerTick and LUnitMove") re-ran
forever inside a single tick and froze the sim.

Add LuaFunction::CallRaising (the unprotected call, restoring the stack top
either way) and use it for TaskTick. Other LuaFunction call sites still go
through the protected call and may swallow script errors the binary would
have reported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f305fd14f70f604a6758a84550a55067b89d64ff)
(cherry picked from commit f7a76a9bab37376167f91a376a05ca3db9e6c636)
---
 src/sdk/lua/LuaObject.h               | 41 +++++++++++++++++++++++++++
 src/sdk/moho/script/CScriptObject.cpp |  7 ++++-
 2 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/src/sdk/lua/LuaObject.h b/src/sdk/lua/LuaObject.h
index 5c10581c..62449e06 100644
--- a/src/sdk/lua/LuaObject.h
+++ b/src/sdk/lua/LuaObject.h
@@ -3117,6 +3117,47 @@ namespace LuaPlus
 			}
 		}
 
+		/**
+		 * operator() through the *unprotected* call (LuaCallUnprotected, the binary's lua_call at
+		 * 0x0090D400): a script error unwinds to the caller as a C++ exception instead of coming back
+		 * as the "result". The Lua stack top is restored either way. The binary's LuaFunction call
+		 * operators use this form (e.g. LuaFunction<int> at 0x006241B0); `lua_call` in this tree maps
+		 * to the protected call, so sites that depend on errors propagating use this instead.
+		 */
+		template<class... Ts>
+		Ret CallRaising(const Ts&... args) const {
+			LuaState* const st = GetActiveState();
+			if (!st) {
+				if constexpr (std::is_void_v<Ret>) {
+					return;
+				} else {
+					return Ret{};
+				}
+			}
+
+			lua_State* const L = st->GetCState();
+			struct TopRestorer {
+				lua_State* state;
+				int top;
+				~TopRestorer() { lua_settop(state, top); }
+			} const restore{L, lua_gettop(L)};
+
+			PushStack(L);
+			(LuaPush(L, args), ...);
+			constexpr int kResultCount = std::is_void_v<Ret> ? 0 : 1;
+			LuaCallUnprotected(L, sizeof...(Ts), kResultCount);
+
+			if constexpr (std::is_void_v<Ret>) {
+				return;
+			} else if constexpr (std::is_same_v<Ret, bool>) {
+				return lua_toboolean(L, -1) != 0;
+			} else if constexpr (std::is_arithmetic_v<Ret>) {
+				return static_cast<Ret>(lua_tonumber(L, -1));
+			} else {
+				return Ret{};
+			}
+		}
+
 		void Call(LuaObject& obj, const char* s, const char* a4, const char* a5) const {
 			(void)(*this)(obj, s, a4, a5);
 		}
diff --git a/src/sdk/moho/script/CScriptObject.cpp b/src/sdk/moho/script/CScriptObject.cpp
index f3ce12ff..b6f0438a 100644
--- a/src/sdk/moho/script/CScriptObject.cpp
+++ b/src/sdk/moho/script/CScriptObject.cpp
@@ -966,7 +966,12 @@ int CScriptObject::TaskTick()
   }
 
   LuaPlus::LuaFunction<int> taskTick{taskTickCallback};
-  return taskTick(mLuaObj);
+  // 0x006241B0 (LuaFunction<int>::operator()) calls the unprotected lua_call (0x0090D400), so a
+  // TaskTick error unwinds to CUnitScriptTask::Execute's handler, which logs it and ends the task.
+  // Through the protected call the error message came back as the "result", converted to 0 --
+  // TASKSTATUS.Repeat -- and a TaskTick that errored every time (e.g. EnhanceTask) spun forever
+  // inside a single tick.
+  return taskTick.CallRaising(mLuaObj);
 }
 
 /**
