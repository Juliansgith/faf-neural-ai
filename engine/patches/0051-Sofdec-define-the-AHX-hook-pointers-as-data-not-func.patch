From 9c80d901acc70567ad904f9e4604c6788df95628 Mon Sep 17 00:00:00 2001
From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:14:32 +0200
Subject: [PATCH 51/56] Sofdec: define the AHX hook pointers as data, not
 functions

SofdecAdxCodecRuntime.cpp reads ahxsetsjifunc, ahxexecfunc and
ahxtermsupplyfunc as function-pointer variables (declared in
SofdecAdxDeclarationsRuntime.cpp) and calls one only when it is set, like
their ahxsetdecsmplfunc sibling. SofdecExternalStubs.cpp defined them as
C-linkage stub functions instead, so the plain link bound each pointer to
the first bytes of a stub's code: never null, and calling it would have
jumped into those bytes. An LTCG link sees the types and leaves all three
unresolved (LNK2001).

Define them as nulled pointers next to ahxsetdecsmplfunc.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 2377d35a00f6083e106486cd6ca55b1ba34e955d)
---
 src/sdk/cri/sofdec/SofdecExternalStubs.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/sdk/cri/sofdec/SofdecExternalStubs.cpp b/src/sdk/cri/sofdec/SofdecExternalStubs.cpp
index a00bc650..2f420cca 100644
--- a/src/sdk/cri/sofdec/SofdecExternalStubs.cpp
+++ b/src/sdk/cri/sofdec/SofdecExternalStubs.cpp
@@ -276,9 +276,6 @@ extern "C" {
   void* adxt_Create() { return nullptr; }
   void* adxt_GetTime() { return nullptr; }
   void* adxt_Pause() { return nullptr; }
-  void* ahxexecfunc() { return nullptr; }
-  void* ahxsetsjifunc() { return nullptr; }
-  void* ahxtermsupplyfunc() { return nullptr; }
   // cft_c_Ycc420plnToArgb8888Int1smp: real body in
   // cri/sofdec/SofdecSvmTransferRuntime.cpp, beside its 2-sample twin.
   // cft_c_Ycc420plnToArgb8888Prg1smp: real body in
@@ -427,6 +424,14 @@ extern "C" {
 // === Function-pointer globals (nulled) ===
 extern "C" {
   void(*ahxsetdecsmplfunc)(void*, std::int32_t) = nullptr;
+  // The AHX codec's other hook pointers. SofdecAdxCodecRuntime.cpp reads them as data (declared in
+  // SofdecAdxDeclarationsRuntime.cpp) and calls one only when it is set. They were stubbed here as
+  // functions, so the plain link bound each pointer to the first bytes of a stub's code - never null,
+  // and calling it would have jumped into those bytes - and an LTCG link, which sees the types, left
+  // all three unresolved.
+  std::int32_t(__cdecl* ahxsetsjifunc)(void* ahxDecoderHandle) = nullptr;
+  std::int32_t(__cdecl* ahxexecfunc)() = nullptr;
+  std::int32_t(__cdecl* ahxtermsupplyfunc)(void* ahxDecoderHandle) = nullptr;
   void(*ahxsetextfunc)(void*, const std::int16_t*) = nullptr;
   std::int32_t(*SFPLY_SetPtsInfo)(std::int32_t, std::int32_t*) = nullptr;
   // SFPLY_ResetPtsm (0x011F9150) is the library's optional "handle was rebuilt,
