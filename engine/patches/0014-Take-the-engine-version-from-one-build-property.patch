From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Tue, 29 Sep 2026 16:17:52 +0200
Subject: [PATCH 14/56] Take the engine version from one build property

The version the engine reports -- GetVersion() in Lua, and the
"Supreme Commander v1.50.NNNN" header replays are written with and must
match to be played back -- was hard-coded as 3764 in three places. FAF
stamps its own release number into every executable it ships (the 3839
build pushes 0xEFF in GetEngineVersion at 0x004D3D3F and in
VCR_SetupReplaySession at 0x00876665), so a build running newer FAF data
rejected every current replay and reported the wrong version to FAF's Lua.

moho/misc/EngineVersion.h now holds the number, defaulting to the recovered
binary's 3764; the MSBuild property FafEngineVersion overrides it for the
two files that use it (e.g. /p:FafEngineVersion=3839), so changing it does
not rebuild the whole project.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 84b31619440c823ae8f36f2269592878a595dd87)
---
 src/sdk/main.vcxproj                 | 12 ++++++++++--
 src/sdk/moho/lua/SCR_String.cpp      |  3 ++-
 src/sdk/moho/misc/EngineVersion.h    | 15 +++++++++++++++
 src/sdk/moho/misc/SessionStartup.cpp |  5 +++--
 4 files changed, 30 insertions(+), 5 deletions(-)
 create mode 100644 src/sdk/moho/misc/EngineVersion.h

diff --git a/src/sdk/main.vcxproj b/src/sdk/main.vcxproj
index a78ac37d..2cc6ad55 100644
--- a/src/sdk/main.vcxproj
+++ b/src/sdk/main.vcxproj
@@ -91,6 +91,9 @@
          must sit beside SupComDataPath.lua. Override on the command line or
          in a .user file to run against a different install. -->
     <FafRunDir Condition="'$(FafRunDir)' == ''">C:\ProgramData\FAForever\bin\</FafRunDir>
+    <!-- Game version the engine reports (GetVersion, replay headers); see moho\misc\EngineVersion.h.
+         3764 is the recovered binary's; FAF's releases carry their own number (e.g. 3839). -->
+    <FafEngineVersion Condition="'$(FafEngineVersion)' == ''">3764</FafEngineVersion>
     <Wm3FoundationDir>$(FafRepoRoot)dependencies\WildMagic3p8\Foundation</Wm3FoundationDir>
     <Wm3IncludePath>$(Wm3FoundationDir);$(Wm3FoundationDir)\Approximation;$(Wm3FoundationDir)\Collision;$(Wm3FoundationDir)\Containment;$(Wm3FoundationDir)\Controllers;$(Wm3FoundationDir)\Curves;$(Wm3FoundationDir)\Detail;$(Wm3FoundationDir)\Distance;$(Wm3FoundationDir)\Effects;$(Wm3FoundationDir)\ImageAnalysis;$(Wm3FoundationDir)\Interpolation;$(Wm3FoundationDir)\Intersection;$(Wm3FoundationDir)\Math;$(Wm3FoundationDir)\Meshes;$(Wm3FoundationDir)\Miscellaneous;$(Wm3FoundationDir)\Numerics;$(Wm3FoundationDir)\ObjectSystem;$(Wm3FoundationDir)\Physics;$(Wm3FoundationDir)\RationalArithmetic;$(Wm3FoundationDir)\SceneGraph;$(Wm3FoundationDir)\Shaders;$(Wm3FoundationDir)\SharedArrays;$(Wm3FoundationDir)\Sorting;$(Wm3FoundationDir)\Surfaces;$(Wm3FoundationDir)\System;$(Wm3FoundationDir)\Terrain;$(Wm3FoundationDir)\Tessellation;$(FafRepoRoot)dependencies\WildMagic3p8\Renderers\Dx9Renderer;$(FafRepoRoot)dependencies\WildMagic3p8\Applications</Wm3IncludePath>
   </PropertyGroup>
@@ -634,7 +637,9 @@ if exist "$(FafRunDir)" if exist "$(TargetDir)$(TargetName).pdb" xcopy /D /Y /Q
     <ClCompile Include="moho\ui\CUIWorldView.cpp" />
     <ClCompile Include="moho\ui\CUIManager.cpp" />
     <ClCompile Include="moho\lua\SCR_Math.cpp" />
-    <ClCompile Include="moho\lua\SCR_String.cpp" />
+    <ClCompile Include="moho\lua\SCR_String.cpp">
+      <PreprocessorDefinitions>FAF_ENGINE_VERSION=$(FafEngineVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions>
+    </ClCompile>
     <ClCompile Include="moho\audio\AudioEngine.cpp" />
     <ClCompile Include="moho\audio\AudioReflectionHelpers.cpp" />
     <ClCompile Include="moho\audio\SParamKeyTypeInfo.cpp" />
@@ -1357,7 +1362,9 @@ if exist "$(FafRunDir)" if exist "$(TargetDir)$(TargetName).pdb" xcopy /D /Y /Q
     <ClCompile Include="moho\ui\IUIManager.cpp" />
     <ClCompile Include="moho\ui\SelectionDragger.cpp" />
     <ClCompile Include="moho\ui\UiRuntimeTypeUpcastBridges.cpp" />
-    <ClCompile Include="moho\misc\SessionStartup.cpp" />
+    <ClCompile Include="moho\misc\SessionStartup.cpp">
+      <PreprocessorDefinitions>FAF_ENGINE_VERSION=$(FafEngineVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions>
+    </ClCompile>
     <ClCompile Include="libpng\PngWriteRuntime.cpp">
       <ExcludedFromBuild Condition="true">true</ExcludedFromBuild>
     </ClCompile>
@@ -1984,6 +1991,7 @@ if exist "$(FafRunDir)" if exist "$(TargetDir)$(TargetName).pdb" xcopy /D /Y /Q
     <ClInclude Include="moho\misc\FileWaitHandleSet.h" />
     <ClInclude Include="moho\misc\StartupHelpers.h" />
     <ClInclude Include="moho\misc\SessionStartup.h" />
+    <ClInclude Include="moho\misc\EngineVersion.h" />
     <ClInclude Include="moho\net\CGpgNetInterface.h" />
     <ClInclude Include="moho\net\CLocalClient.h" />
     <ClInclude Include="moho\net\CNetDatagramSocketImpl.h" />
diff --git a/src/sdk/moho/lua/SCR_String.cpp b/src/sdk/moho/lua/SCR_String.cpp
index 08cdda4b..71923674 100644
--- a/src/sdk/moho/lua/SCR_String.cpp
+++ b/src/sdk/moho/lua/SCR_String.cpp
@@ -1,4 +1,5 @@
 #include "moho/lua/SCR_String.h"
+#include "moho/misc/EngineVersion.h"
 
 #include "gpg/core/containers/String.h"
 #include "gpg/core/streams/BinaryReader.h"
@@ -384,7 +385,7 @@ moho::CScrLuaInitForm* moho::register_STR_GetTokens_LuaFuncDef()
  */
 msvc8::string moho::GetEngineVersion()
 {
-  return gpg::STR_Printf("%1.1f.%i", 1.5, 3764);
+  return gpg::STR_Printf("%1.1f.%i", 1.5, kEngineBuildVersion);
 }
 
 /**
diff --git a/src/sdk/moho/misc/EngineVersion.h b/src/sdk/moho/misc/EngineVersion.h
new file mode 100644
index 00000000..312b4fe4
--- /dev/null
+++ b/src/sdk/moho/misc/EngineVersion.h
@@ -0,0 +1,15 @@
+#pragma once
+
+// The game version the engine reports: GetVersion() in Lua, and the "Supreme Commander v1.50.NNNN"
+// header that replays are written with and must match to be played back. The recovered binary says
+// 3764; FAF stamps its own release number into every copy it ships (the 3839 executable pushes 0xEFF
+// in GetEngineVersion and in VCR_SetupReplaySession), so a build meant to run with newer FAF data sets
+// the MSBuild property FafEngineVersion, which defines FAF_ENGINE_VERSION for the files that use it.
+#ifndef FAF_ENGINE_VERSION
+#define FAF_ENGINE_VERSION 3764
+#endif
+
+namespace moho
+{
+  inline constexpr int kEngineBuildVersion = FAF_ENGINE_VERSION;
+} // namespace moho
diff --git a/src/sdk/moho/misc/SessionStartup.cpp b/src/sdk/moho/misc/SessionStartup.cpp
index 78719cbf..3cd0fdc0 100644
--- a/src/sdk/moho/misc/SessionStartup.cpp
+++ b/src/sdk/moho/misc/SessionStartup.cpp
@@ -1,4 +1,5 @@
 #include "moho/misc/SessionStartup.h"
+#include "moho/misc/EngineVersion.h"
 
 #include <Windows.h>
 
@@ -347,7 +348,7 @@ namespace moho
     constexpr std::size_t kReplayFormatBannerBytes = sizeof(kReplayFormatBanner) - 1u;
     /// The build the retail replay header advertises.
     constexpr double kReplayEngineVersion = 1.5;
-    constexpr int kReplayEngineBuild = 3764;
+    constexpr int kReplayEngineBuild = kEngineBuildVersion;
     /// Terminates one army's unit-source list; no source index can reach it.
     constexpr std::uint8_t kReplayUnitSourceListEnd = 0xFFu;
   } // namespace
@@ -494,7 +495,7 @@ namespace moho
     }
 
     gpg::BinaryReader replayReader(replayStream.get());
-    const msvc8::string expectedVersion = gpg::STR_Printf("Supreme Commander v%1.2f.%4i", 1.5, 3764);
+    const msvc8::string expectedVersion = gpg::STR_Printf("Supreme Commander v%1.2f.%4i", 1.5, kEngineBuildVersion);
     msvc8::string replayVersion{};
     replayReader.ReadString(&replayVersion);
     if (replayVersion.view() != expectedVersion.view()) {
