+    constexpr int kProtocolVersion = 1;
+    constexpr int kDefaultAgentSpeed = 50;
+    constexpr int kDefaultConnectTimeoutSeconds = 60;
+    constexpr int kMaxJsonDepth = 48;
+    constexpr int kMaxWaitTicks = 1 << 20;
