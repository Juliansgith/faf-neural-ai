-    out.axis0 = right;
-    out.axis1 = forward;
-    out.extent0 = lateralExtent;
+    out.center = {position.x + (frame.forward.x * leadDistance), position.z + (frame.forward.y * leadDistance)};
+    out.axis0 = frame.right;
