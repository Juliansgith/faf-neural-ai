From: Julian Cooper <115541810+Juliansgith@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:33:49 +0200
Subject: [PATCH 43/56] Path search: inline the cluster edge-cost helpers

Cluster::DequantizeEdgeCost (0x0092D8E0) and Cluster::NodeOctileDistance
(0x007658D0) are a table lookup times a distance and a four-operation octile
distance, but they lived in Cluster.cpp and every cluster edge the path
search relaxes (EnumerateClusterEdges in PathTables.cpp) paid two calls for
them - together 2-3 % of the sim thread in AI-vs-AI games. They are now
defined inline in Cluster.h; same expressions, and the inputs (byte node
coordinates, the 32-entry scale table) are always finite, so the results
cannot depend on how the compiler orders them.

Verified with the 30-minute all-AI checksum run (identical over all 18002
beats, together with the previous change).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit cd7f23f0fe814f578fa228fe40384580a5a92839)
---
 src/sdk/gpg/core/algorithms/Cluster.cpp | 43 ++-----------------------
 src/sdk/gpg/core/algorithms/Cluster.h   | 34 +++++++++++++++++--
 2 files changed, 35 insertions(+), 42 deletions(-)

diff --git a/src/sdk/gpg/core/algorithms/Cluster.cpp b/src/sdk/gpg/core/algorithms/Cluster.cpp
index 43debdda..d8362f19 100644
--- a/src/sdk/gpg/core/algorithms/Cluster.cpp
+++ b/src/sdk/gpg/core/algorithms/Cluster.cpp
@@ -3902,46 +3902,9 @@ gpg::Rect2i ClusterMap::ClusterIndexRect(const int worldX, const int worldZ, con
     return gpg::HaStar::ClusterIndexRect(worldX, worldZ, level, (mWidth >> shift), (mHeight >> shift));
 }
 
-/**
- * Address: 0x0092D8E0 (?DequantizeEdgeCost@Cluster@HaStar@gpg@@SAMHM@Z)
- *
- * What it does:
- * Inverts `QuantizeEdgeCost`. The 32 entries are `exp(q / 6)` for q in 0..31,
- * read from the binary at 0x00E35DA0 and verified against the closed form.
- */
-float Cluster::DequantizeEdgeCost(const int bucket, const float distance)
-{
-    static constexpr float kBucketScale[32] = {
-        1.0f,          1.18136041f,   1.39561241f,   1.64872122f,
-        1.94773400f,   2.30097604f,   2.71828175f,   3.21127081f,
-        3.79366802f,   4.48168898f,   5.29449005f,   6.25470114f,
-        7.38905621f,   8.72913837f,   10.3122587f,   12.1824942f,
-        14.3919163f,   17.0020409f,   20.0855370f,   23.7282581f,
-        28.0316257f,   33.1154518f,   39.1212845f,   46.2163353f,
-        54.5981483f,   64.5000916f,   76.1978607f,   90.0171280f,
-        106.342674f,   125.629028f,   148.413162f,   175.329437f,
-    };
-
-    return kBucketScale[bucket] * distance;
-}
-
-/**
- * Address: 0x007658D0 (FUN_007658D0)
- *
- * What it does:
- * Octile distance between two of a cluster's boundary nodes.
- */
-float Cluster::NodeOctileDistance(const Data& data, const std::uint32_t lhs, const std::uint32_t rhs)
-{
-    const float deltaX = std::fabs(
-        static_cast<float>(data.mNodes[rhs].x) - static_cast<float>(data.mNodes[lhs].x));
-    const float deltaZ = std::fabs(
-        static_cast<float>(data.mNodes[rhs].z) - static_cast<float>(data.mNodes[lhs].z));
-
-    return (deltaZ <= deltaX)
-        ? (deltaZ * 0.41421354f) + deltaX
-        : (deltaX * 0.41421354f) + deltaZ;
-}
+// Address: 0x0092D8E0 (?DequantizeEdgeCost@Cluster@HaStar@gpg@@SAMHM@Z) and
+// Address: 0x007658D0 (FUN_007658D0, Cluster::NodeOctileDistance) are defined
+// inline in Cluster.h.
 
 /**
  * Address: 0x008E33B0 (FUN_008E33B0)
diff --git a/src/sdk/gpg/core/algorithms/Cluster.h b/src/sdk/gpg/core/algorithms/Cluster.h
index 62637bde..1429f36e 100644
--- a/src/sdk/gpg/core/algorithms/Cluster.h
+++ b/src/sdk/gpg/core/algorithms/Cluster.h
@@ -1,6 +1,7 @@
 // Auto-generated from IDA VFTABLE/RTTI scan.
 // This header is a skeleton for reverse-engineering; adjust as needed.
 #pragma once
+#include <cmath>
 #include <cstddef>
 #include <cstdint>
 
@@ -173,8 +174,25 @@ namespace gpg::HaStar
          * Inverts `QuantizeEdgeCost`: scales `distance` by `exp(bucket / 6)`,
          * read from a 32-entry table rather than recomputed. The table lives at
          * 0x00E35DA0 and was verified entry-by-entry against `exp(q / 6)`.
+         *
+         * Defined here, inline: the path search calls it for every cluster edge
+         * it relaxes, and out of line the call cost more than the multiply.
          */
-        [[nodiscard]] static float DequantizeEdgeCost(int bucket, float distance);
+        [[nodiscard]] static float DequantizeEdgeCost(const int bucket, const float distance)
+        {
+            static constexpr float kBucketScale[32] = {
+                1.0f,          1.18136041f,   1.39561241f,   1.64872122f,
+                1.94773400f,   2.30097604f,   2.71828175f,   3.21127081f,
+                3.79366802f,   4.48168898f,   5.29449005f,   6.25470114f,
+                7.38905621f,   8.72913837f,   10.3122587f,   12.1824942f,
+                14.3919163f,   17.0020409f,   20.0855370f,   23.7282581f,
+                28.0316257f,   33.1154518f,   39.1212845f,   46.2163353f,
+                54.5981483f,   64.5000916f,   76.1978607f,   90.0171280f,
+                106.342674f,   125.629028f,   148.413162f,   175.329437f,
+            };
+
+            return kBucketScale[bucket] * distance;
+        }
 
         /**
          * Address: 0x007658D0 (FUN_007658D0)
@@ -184,8 +202,20 @@ namespace gpg::HaStar
          * `max + min * (sqrt(2) - 1)`. Pairs with the stored edge bucket, which
          * only records how much worse the real path is than this straight-line
          * lower bound.
+         *
+         * Defined here, inline, for the same reason as `DequantizeEdgeCost`.
          */
-        [[nodiscard]] static float NodeOctileDistance(const Data& data, std::uint32_t lhs, std::uint32_t rhs);
+        [[nodiscard]] static float NodeOctileDistance(const Data& data, const std::uint32_t lhs, const std::uint32_t rhs)
+        {
+            const float deltaX = std::fabs(
+                static_cast<float>(data.mNodes[rhs].x) - static_cast<float>(data.mNodes[lhs].x));
+            const float deltaZ = std::fabs(
+                static_cast<float>(data.mNodes[rhs].z) - static_cast<float>(data.mNodes[lhs].z));
+
+            return (deltaZ <= deltaX)
+                ? (deltaZ * 0.41421354f) + deltaX
+                : (deltaX * 0.41421354f) + deltaZ;
+        }
 
